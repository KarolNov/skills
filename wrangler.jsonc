// The docs site (docs/), served as static assets by a Worker with no script of its own.
// Workers Builds builds it from this repo: `npm ci && npm run docs:build`, then
// `npx wrangler deploy` on main and `npx wrangler preview` on other branches.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blueprint-docs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "docs/.vitepress/dist",
    // VitePress builds clean URLs (/modes/coverage → modes/coverage.html) and its own 404.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "blueprint.karolnov.dev", "custom_domain": true }]
}

// The docs site (docs/), served as static assets by a Worker with no script of its own.
// Workers Builds builds it from this repo: `npm ci && npm run docs:build`, then
// `npx wrangler deploy` on main and `npx wrangler preview` on other branches.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blueprint-docs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "docs/.vitepress/dist",
    // VitePress builds clean URLs (/modes/coverage → modes/coverage.html) and its own 404.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // previews_enabled also serves each branch's preview at <branch>.blueprint.karolnov.dev
  // (Cloudflare adds the wildcard DNS record and certificate). It takes effect on a `wrangler deploy`.
  "routes": [{ "pattern": "blueprint.karolnov.dev", "custom_domain": true, "previews_enabled": true }],
  // `wrangler preview` (pull request previews) refuses to run without this block. Empty is enough:
  // previews share the assets and compatibility settings above.
  "previews": {}
}
